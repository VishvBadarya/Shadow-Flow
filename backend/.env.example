# =========================================
# MediCare Nexus Backend — Environment Variables
# =========================================
# Copy this file to `.env` and fill in values.
# =========================================

# Server port (default: 5000)
PORT=5000

# Frontend URL for CORS (comma-separated for multiple origins)
# Local dev: http://localhost:5173
# Production: https://medicare-nexus.com
FRONTEND_URL=http://localhost:5173

# Supabase (optional — only if using cloud Supabase instead of PGlite)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# PostgreSQL (optional — only if using external PostgreSQL instead of PGlite)
# DATABASE_URL=

# Node environment
NODE_ENV=development
