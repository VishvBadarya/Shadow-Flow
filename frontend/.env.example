# =========================================
# MediCare Nexus Frontend — Environment Variables
# =========================================
# Copy this file to `.env` and fill in values.
# For local dev, leave VITE_API_URL empty (Vite proxy handles it).
# For production, set it to your deployed backend URL.
# =========================================

# Backend API URL (no trailing slash)
# Local dev: leave blank → uses Vite proxy to http://localhost:5000
# Production: set to your deployed backend, e.g. https://api.medicare-nexus.com
VITE_API_URL=
